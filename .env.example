APP_NAME=Lectura
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# MCP Server — static Bearer token (simple setup, Claude Code CLI)
MCP_SECRET=

# MCP OAuth 2.0 — used when connecting via Claude.ai Advanced Settings
# Generate with: php -r "echo bin2hex(random_bytes(16)) . ':' . bin2hex(random_bytes(32));"
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_TOKEN_TTL=3600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — MySQL for production, SQLite for dev
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lectura
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lectura.app"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Sign in with Apple (mobile app) — the audience of the identity token, i.e. the
# iOS bundle id. Comma-separate to accept more than one bundle.
APPLE_CLIENT_IDS=com.lectura.go
# Only needed to revoke the Apple token when an account is deleted (App Store
# requirement). APPLE_PRIVATE_KEY_PATH points at the .p8 downloaded from the
# Apple Developer portal; APPLE_PRIVATE_KEY holds the same PEM inline instead.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Firebase Cloud Messaging (mobile push) — path to the Firebase service-account
# JSON. Empty means notifications stay in-app only.
FCM_CREDENTIALS_PATH=

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=${APP_URL}/settings/drive/callback

# AI Providers
AI_DEFAULT_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Reverb (WebSocket)
# Generate a fresh key and secret per environment — never ship values committed
# to this repo. Reverb signs private and presence channel authorisation as
# HMAC(secret, "socket_id:channel"), so a publicly known secret lets anyone
# subscribe to private channels without signing in, whatever Broadcast::channel
# says. Blank is safe: the client only initialises when VITE_REVERB_APP_KEY is
# set, so broadcasting stays off until you configure it.
# Populate with: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# The address the Reverb process itself binds to (defaults to 0.0.0.0). Behind a
# reverse proxy keep it on loopback so the websocket port is never reachable
# from the internet directly.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
# What the BROWSER dials. The interpolation below is correct for local
# development only, where the browser really is on localhost:8080. Deployed, it
# would bake ws://localhost:8080 into the compiled bundle and every visitor
# would try to connect to their own machine — set the public values explicitly:
#   VITE_REVERB_HOST=lectura.example.com
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
